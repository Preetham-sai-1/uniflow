# ─── Environment Variables Template ──────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# MongoDB — use a MongoDB Atlas connection string or a local URI
# Atlas format:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/uniflow?retryWrites=true&w=majority
# Local format:  mongodb://localhost:27017/uniflow
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/uniflow?retryWrites=true&w=majority

# JWT — generate a long random secret (e.g. openssl rand -hex 64)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# Frontend origin — must match the React dev server URL exactly
FRONTEND_URL=http://localhost:5173

# Flutter Web origin — development server URL for Flutter Web
FLUTTER_WEB_URL=http://localhost:7357

# Bcrypt cost factor — higher is more secure but slower (10 is a safe default)
BCRYPT_SALT_ROUNDS=10
